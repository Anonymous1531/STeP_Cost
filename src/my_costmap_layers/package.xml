<?xml version="1.0"?>
<package format="3">
  <name>my_costmap_layers</name>
  <version>0.1.0</version>
  <description>STeP-Cost residual obstacle-cost layer for Navigation2.</description>
  <maintainer email="anonymous@example.com">Anonymous</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_util</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <nav2_costmap_2d plugin="${prefix}/plugins/costmap_plugins.xml" />
  </export>
</package>
